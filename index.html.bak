<style>
:root{--ink:#19303a;--muted:#637477;--green:#1d6558;--lime:#dceacb;--paper:#f6f5ef;--white:#fff;--line:#dce2da;--serif:Georgia,'Times New Roman',serif;--sans:Inter,ui-sans-serif,system-ui,-apple-system,'Segoe UI',sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 var(--sans)}a{color:inherit}.wrap{width:min(1080px,calc(100% - 40px));margin:auto}.nav{display:flex;justify-content:space-between;align-items:center;padding:22px 0}.brand{font:700 1.2rem var(--serif);text-decoration:none}.links{display:flex;gap:22px;align-items:center}.links a{text-decoration:none;color:var(--muted);font-size:.92rem}.links .cta{background:var(--green);color:white;padding:9px 15px;border-radius:50px}.hero{padding:88px 0 76px;border-top:1px solid var(--line);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;z-index:-1;background:var(--lime);width:380px;height:380px;border-radius:50%;right:-80px;top:-100px;opacity:.65}.eyebrow,.kicker{color:var(--green);font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:750}.eyebrow:before{content:"✳ ";}h1{font:500 clamp(3rem,7vw,5.5rem)/.98 var(--serif);letter-spacing:-.05em;margin:18px 0;max-width:750px}h1 em{color:var(--green)}h2{font:500 clamp(2rem,4vw,3.15rem)/1.08 var(--serif);letter-spacing:-.03em;margin:9px 0}.lead{max-width:660px;color:var(--muted);font-size:1.12rem}.buttons{display:flex;gap:11px;flex-wrap:wrap;margin-top:25px}.button{display:inline-block;padding:11px 17px;border:1px solid var(--green);border-radius:50px;text-decoration:none;font-weight:700}.primary{background:var(--green);color:white}.meta{display:flex;gap:22px;flex-wrap:wrap;margin-top:32px;color:var(--muted);font-size:.9rem}.meta span:before{content:"• ";color:var(--green)}.section{padding:70px 0;border-top:1px solid var(--line)}.head{display:grid;grid-template-columns:.85fr 1.15fr;gap:30px;margin-bottom:32px}.intro{color:var(--muted);align-self:end}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.card,.job,.skill{background:white;border:1px solid var(--line);border-radius:16px;padding:23px}.stat{font:500 1.8rem var(--serif);color:var(--green);margin-bottom:4px}.small,.company{color:var(--muted);font-size:.91rem}.timeline{display:grid;gap:13px}.job{display:grid;grid-template-columns:175px 1fr;gap:22px}.date{font-weight:700;color:var(--green);font-size:.9rem}.job h3,.skill h3{font:600 1.24rem var(--serif);margin:0}.company{margin:2px 0 14px}.job ul{padding-left:19px;margin:0;color:#354a50}.job li+li{margin-top:7px}.skills{display:grid;grid-template-columns:1fr 1fr;gap:14px}.skill h3{margin-bottom:12px}.tags{display:flex;gap:8px;flex-wrap:wrap}.tag{border:1px solid var(--line);padding:6px 10px;border-radius:30px;color:#40565a;font-size:.88rem}.proof{display:grid;grid-template-columns:1fr 1fr;gap:14px}.proof a{min-height:190px;padding:24px;border-radius:16px;background:var(--ink);color:white;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between}.proof a:nth-child(2){background:var(--green)}.proof small{color:#dceacb;text-transform:uppercase;letter-spacing:.1em}.proof strong{font:500 1.6rem/1.2 var(--serif)}.contact{background:var(--ink);color:white;border-radius:20px;padding:36px;display:grid;grid-template-columns:1.2fr .8fr;gap:24px}.contact h2{margin:8px 0}.contact p{color:#d2dedb}.contact a{color:white;text-decoration:none;border-bottom:1px solid #71827e;padding:8px 0}.contactset{display:grid;align-content:center;gap:8px}.footer{padding:24px 0;color:var(--muted);font-size:.85rem;display:flex;justify-content:space-between;flex-wrap:wrap}
@media(max-width:700px){.wrap{width:calc(100% - 28px)}.nav{align-items:flex-start}.links{justify-content:flex-end;gap:11px;flex-wrap:wrap}.links a{font-size:.82rem}.hero{padding:65px 0 55px}.hero:after{width:240px;height:240px;right:-110px}.section{padding:52px 0}.head,.contact{grid-template-columns:1fr;gap:12px}.grid,.skills,.proof{grid-template-columns:1fr}.job{grid-template-columns:1fr;gap:7px}.card,.job,.skill{padding:19px}.contact{padding:25px}.footer{display:block}.footer span{display:block;margin-top:5px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
